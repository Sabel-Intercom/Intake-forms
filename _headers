# Cloudflare Pages response headers.
#
# hub-auth.js decides which token a page sends. On the hubs domain it was
# being served with a 4 hour browser cache (the zone's default for .js), so a
# fix to it took up to 4 hours to reach a returning visitor. "private" keeps
# it out of the shared cache and "no-cache" makes the browser check for a new
# copy on every page load (a small 304 when nothing changed).
/hub-auth.js
  Cache-Control: private, no-cache
